<?xml version="1.0" encoding="UTF-8"?>
<!--
  Local manifest overlay for building LineageOS 21.0 for HTC U Ultra (oce).

  Initialize the official LineageOS manifest first, then copy this file to
  .repo/local_manifests/oce.xml before running repo sync.
-->
<manifest>
  <remote name="oce" fetch="https://github.com/LineageOS-HTC-U-Ultra" />

  <!-- Device and kernel trees hosted by the HTC U Ultra org. -->
  <project name="device_htc_oce"
           path="device/htc/oce"
           remote="oce"
           revision="refs/heads/lineage-21.0" />
  <project name="android_kernel_htc_oce"
           path="kernel/htc/oce"
           remote="oce"
           revision="refs/heads/lineage-21.0" />
  <project name="proprietary_vendor_htc"
           path="vendor/htc"
           remote="oce"
           revision="refs/heads/lineage-21.0" />

  <!-- Forks that replace the corresponding LineageOS projects. -->
  <remove-project name="LineageOS/android_frameworks_av" />
  <project name="android_frameworks_av"
           path="frameworks/av"
           remote="oce"
           revision="refs/heads/lineage-21.0" />

  <remove-project name="LineageOS/android_packages_modules_Connectivity" />
  <project name="android_packages_modules_Connectivity"
           path="packages/modules/Connectivity"
           remote="oce"
           revision="refs/heads/lineage-21.0" />

  <remove-project name="LineageOS/android_system_netd" />
  <project name="android_system_netd"
           path="system/netd"
           remote="oce"
           revision="refs/heads/lineage-21.0" />

  <remove-project name="LineageOS/android_system_libhidl" />
  <project name="android_system_libhidl"
           path="system/libhidl"
           remote="oce"
           revision="refs/heads/lineage-21.0" />

  <remove-project name="LineageOS/android_hardware_lineage_interfaces" />
  <project name="android_hardware_lineage_interfaces"
           path="hardware/lineage/interfaces"
           remote="oce"
           revision="refs/heads/lineage-21.0" />

  <!--
    This upstream project is pinned because the required CNE API commit is on
    the public LineageOS repository but there is no usable lineage-21.0 branch.
  -->
  <project name="LineageOS/android_external_connectivity"
           path="external/connectivity"
           remote="github"
           revision="0bcb1672a85eaa9e0e198a1aa7b5f6fe37884a7a" />

</manifest>
